<Window x:Class="LiveSub.Launcher.SubtitleOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LiveSub 实时字幕"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Width="1180" SizeToContent="Height" MaxHeight="360">
    <Border x:Name="Shell" CornerRadius="10" Background="#D9000000" Padding="0">
        <Border.ContextMenu>
            <!-- The right click lands on the drag bar, because that is the only part of the
                 overlay that answers the mouse. Both opacities are sliders so the user can find
                 the value they like instead of stepping through presets. -->
            <ContextMenu>
                <MenuItem x:Name="CopyItem" Header="复制当前字幕" Click="Copy_Click" />
                <MenuItem x:Name="TopItem" Header="取消置顶" Click="Topmost_Click" />
                <Separator />
                <MenuItem x:Name="BackgroundItem" StaysOpenOnClick="True">
                    <MenuItem.Header>
                        <Slider x:Name="BackgroundSlider" Width="180" Minimum="0" Maximum="100"
                                TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                ValueChanged="BackgroundSlider_ValueChanged" />
                    </MenuItem.Header>
                </MenuItem>
                <MenuItem x:Name="TextItem" StaysOpenOnClick="True">
                    <MenuItem.Header>
                        <Slider x:Name="TextSlider" Width="180" Minimum="0" Maximum="100"
                                TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                ValueChanged="TextSlider_ValueChanged" />
                    </MenuItem.Header>
                </MenuItem>
                <MenuItem x:Name="ResetItem" Header="恢复默认透明度" Click="ResetOpacity_Click" />
                <Separator />
                <MenuItem x:Name="CloseItem" Header="关闭悬浮字幕" Click="Close_Click" />
            </ContextMenu>
        </Border.ContextMenu>
        <DockPanel>
            <!-- The bar is the only part of the overlay that answers the mouse: everywhere else
                 WM_NCHITTEST answers HTTRANSPARENT, so a click belongs to the application the
                 user is working in. The bar answers HTCAPTION, which makes the window manager
                 drag the whole strip; because that also turns a right click into a non-client
                 message, the code-behind answers WM_NCRBUTTONUP by opening the overlay's own
                 menu - the menu the bar advertises. -->
            <Border x:Name="DragBar" DockPanel.Dock="Top" Height="20" CornerRadius="10,10,0,0" Background="#33FFFFFF"
                    Cursor="SizeAll" ToolTip="按住拖动可移动位置；右键菜单可调透明度">
                <TextBlock x:Name="BarHint" Text="LiveSub 悬浮字幕 · 拖动此处移动位置（右键菜单）" FontSize="11" Foreground="#E6FFFFFF"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock x:Name="Caption" Margin="22,10,22,14" FontSize="34" FontWeight="SemiBold"
                       Foreground="#FFFFFFFF" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" LineHeight="46">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#FF000000" BlurRadius="8" ShadowDepth="1.5" Opacity="0.9" />
                </TextBlock.Effect>
            </TextBlock>
        </DockPanel>
    </Border>
</Window>
