<Window x:Class="LiveSub.Launcher.SubtitleOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LiveSub 实时字幕"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Width="1180" SizeToContent="Height" MaxHeight="360">
    <Border x:Name="Shell" CornerRadius="10" Background="#D9000000" Padding="0">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="CopyItem" Header="复制当前字幕" Click="Copy_Click" />
                <MenuItem x:Name="TopItem" Header="取消置顶" Click="Topmost_Click" />
                <Separator />
                <MenuItem x:Name="CloseItem" Header="关闭悬浮字幕" Click="Close_Click" />
            </ContextMenu>
        </Border.ContextMenu>
        <DockPanel>
            <!-- The bar is the only visible control: dragging it moves the window, so the
                 rest of the overlay stays click-through and never steals a click from the
                 application the user is actually working in. -->
            <Border x:Name="DragBar" DockPanel.Dock="Top" Height="18" CornerRadius="10,10,0,0" Background="#26FFFFFF"
                    MouseLeftButtonDown="DragBar_MouseLeftButtonDown" MouseMove="DragBar_MouseMove"
                    MouseLeftButtonUp="DragBar_MouseLeftButtonUp" Cursor="SizeAll"
                    ToolTip="按住拖动可移动位置；右键可关闭悬浮字幕">
                <TextBlock x:Name="BarHint" Text="LiveSub 悬浮字幕 · 拖动此处移动" FontSize="10" Foreground="#B3FFFFFF"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock x:Name="Caption" Margin="22,10,22,14" FontSize="34" FontWeight="SemiBold"
                       Foreground="#FFFFFFFF" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" LineHeight="46">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#FF000000" BlurRadius="8" ShadowDepth="1.5" Opacity="0.9" />
                </TextBlock.Effect>
            </TextBlock>
        </DockPanel>
    </Border>
</Window>
