<UserControl x:Class="LiveSub.Launcher.SubtitleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="LiveSub" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
            <TextBlock x:Name="HeaderStatus" Text="已安装，待启动检查" Margin="16,11,0,0" Foreground="{StaticResource MutedBrush}" />
        </DockPanel>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="OfflineMode" Content="离线视频" Width="160" Click="OfflineMode_Click" />
                <Button x:Name="LiveMode" Content="实时系统音频" Width="160" Margin="8,0,0,0" Click="LiveMode_Click" />
            </StackPanel>
            <TextBlock x:Name="HeroTitle" Text="开始生成中文字幕" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0" />
            <TextBlock Text="英语、日语 → 简体中文" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border x:Name="VideoCard" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="选择本地视频" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="读取首个音轨，生成独立 SRT 字幕；原视频保持不变" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,8" />
                            <TextBox x:Name="VideoPath" IsReadOnly="True" TextChanged="Input_Changed" />
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="ChooseVideoButton" Content="选择视频" Margin="12,34,0,0" Click="ChooseVideo_Click" />
                    </Grid>
                </Border>

                <Border x:Name="AudioCard" Style="{StaticResource Card}" Visibility="Collapsed" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="系统音频设备" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="请选择能采集系统播放声音的回环设备；设备存在不代表正在采集" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,8" />
                            <ComboBox x:Name="AudioDevices" SelectionChanged="Input_Changed" />
                            <TextBlock x:Name="AudioHint" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="RefreshDevicesButton" Content="刷新" Margin="12,34,0,0" Click="RefreshDevices_Click" />
                    </Grid>
                </Border>

                <Border x:Name="ParameterCard" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="源语言" Margin="0,0,0,6" />
                            <ComboBox x:Name="SourceLanguage" SelectedIndex="0" SelectionChanged="Input_Changed">
                                <ComboBoxItem Content="自动检测" Tag="auto" />
                                <ComboBoxItem Content="英语" Tag="en" />
                                <ComboBoxItem Content="日语" Tag="ja" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="翻译模型" Margin="0,0,0,6" />
                            <ComboBox x:Name="Model" SelectedIndex="0" SelectionChanged="Input_Changed">
                                <ComboBoxItem Content="Hy-MT2 7B" Tag="7b" />
                                <ComboBoxItem x:Name="SmallModel" Content="Hy-MT2 1.8B" Tag="1.8b" IsEnabled="False" />
                            </ComboBox>
                            <TextBlock x:Name="ModelHint" Text="1.8B 已安装时可选" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="翻译设备" Margin="0,0,0,6" />
                            <ComboBox x:Name="Device" SelectedIndex="0" SelectionChanged="Input_Changed">
                                <ComboBoxItem Content="GPU" Tag="gpu" />
                                <ComboBoxItem Content="CPU" Tag="cpu" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="HotwordCard" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="识别热词（可选）" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="如果出现专有名词容易被听错的情况，把人名、产品名、术语写在这里。留空即不使用；会作为识别上下文，不影响字幕时间轴"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,4,0,8" TextWrapping="Wrap" />
                        <TextBox x:Name="Hotwords" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52" VerticalScrollBarVisibility="Auto"
                                 TextChanged="Input_Changed" />
                    </StackPanel>
                </Border>

                <Border x:Name="PromptCard" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="翻译要求（可选）" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="这段说明会放在每句原文之前交给翻译模型，用来控制术语、称呼和语气。留空使用内置默认值（就是原来一直用的那句）；改坏了点「恢复默认」即可"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,4,0,8" TextWrapping="Wrap" />
                        <TextBox x:Name="MtPrompt" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" VerticalScrollBarVisibility="Auto"
                                 TextChanged="Input_Changed" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="PromptDefaultButton" Content="恢复默认" Width="110" Click="PromptDefault_Click" />
                            <TextBlock x:Name="PromptHint" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="OutputCard" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="保存位置" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <TextBox Grid.Column="1" x:Name="OutputPath" TextChanged="Input_Changed" />
                        <Button Grid.Column="2" x:Name="ChooseOutputButton" Content="浏览…" Margin="12,0,0,0" Click="ChooseOutput_Click" />
                        <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Text="同时保存同名诊断 JSONL；已有文件不会覆盖" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,43,0,0" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" MinHeight="170">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" x:Name="SavedTitle" Text="已保存字幕 · 0 条" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" />
                        <TextBlock DockPanel.Dock="Bottom" x:Name="PreviewHint" Foreground="{StaticResource MutedBrush}" FontSize="12" Visibility="Collapsed" />
                        <ListBox x:Name="SubtitleList" BorderThickness="0" ScrollViewer.CanContentScroll="True"
                                 VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4,0,8">
                                        <TextBlock Text="{Binding Header}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                        <TextBlock Text="{Binding Text}" FontSize="14" Margin="0,3,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Background="#F9FAFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,1,1,1" CornerRadius="12" Padding="16" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <ProgressBar x:Name="StartupBar" Height="6" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed"
                                 Foreground="{StaticResource PrimaryBrush}" Background="#E6E9F5" BorderThickness="0" Margin="0,0,0,8" />
                    <!-- Offline mode runs faster than the video plays, so the bar shows real
                         processed audio: the same bar that showed the model load continues
                         into the file, and the text next to it carries the remaining time. -->
                    <ProgressBar x:Name="RunBar" Height="6" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed"
                                 Foreground="#2E9E63" Background="#E6E9F5" BorderThickness="0" Margin="0,0,0,8" />
                    <TextBlock x:Name="TaskStatus" Text="选择输入和保存位置后即可开始" />
                    <TextBlock x:Name="TaskDetail" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1" x:Name="ActionButton" Content="开始生成" Width="180" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="ActionButton_Click" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
